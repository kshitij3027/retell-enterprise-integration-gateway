# REIG — environment variable template. Safe to commit.
# Copy to .env and fill real values. .env is gitignored.

# --- Core ---
REIG_DATABASE_URL=postgresql://reig_app:reig_app@db:5432/reig
# Generate with: openssl rand -base64 32
REIG_ENCRYPTION_KEY=__GENERATE_WITH_OPENSSL_RAND_BASE64_32__
REIG_LOG_LEVEL=INFO

# --- Retell (from dashboard.retellai.com/apiKeys) ---
REIG_RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REIG_WEBHOOK_TIMESTAMP_SKEW_SECONDS=300
REIG_WEBHOOK_RESPONSE_SLA_SECONDS=2

# --- ngrok (from dashboard.ngrok.com/domains; free-tier dev domain is fine) ---
REIG_NGROK_DOMAIN=your-reserved-subdomain.ngrok-free.dev

# --- Salesforce (from your External Client App in Setup → App Manager) ---
# Setup → App Manager → New External Client App, OAuth enabled,
# scopes = api + refresh_token, IP Relaxation = "Relax IP restrictions"
REIG_SFDC_CLIENT_ID=3MVG9...consumer_key_here
REIG_SFDC_CLIENT_SECRET=your_consumer_secret_here
REIG_SFDC_LOGIN_URL=https://login.salesforce.com
REIG_SFDC_API_VERSION=v60.0
REIG_SFDC_INSTANCE_URL=https://<your-org>.develop.my.salesforce.com
REIG_SFDC_CALLBACK_URL=https://<your-ngrok-domain>/admin/oauth/callback

# --- Retry ---
REIG_RETRY_MAX_ATTEMPTS=5
REIG_RETRY_BACKOFF_BASE_SECONDS=2
REIG_RETRY_BACKOFF_MAX_SECONDS=60

# --- Adapter / PII ---
REIG_ACTIVE_ADAPTER=salesforce
REIG_PII_REDACTION_ENABLED=true
REIG_PII_ENTITIES=PHONE_NUMBER,US_SSN,EMAIL_ADDRESS,CREDIT_CARD
REIG_PHI_MODE=false

# --- Observability ---
REIG_OTEL_ENDPOINT=http://jaeger:4317
REIG_OTEL_SERVICE_NAME=retell-integration-gateway

# --- Tenant / keys ---
REIG_TENANT_API_KEY_PREFIX=reig_

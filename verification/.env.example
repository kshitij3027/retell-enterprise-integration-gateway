# Template for verification/.env — copy to verification/.env (gitignored)
# before running /ui-review. These values back the {{VAR}} substitutions
# in verification/stories.yaml.

# Salesforce org URL (same domain you reach Lightning at)
SFDC_ORG_URL=https://your-org.develop.my.salesforce.com
SFDC_USERNAME=you@example.com
SFDC_PASSWORD=__replace_me__

# One of the call_ids from tests/fixtures/valid_call_analyzed_with_pii.json
TEST_CALL_ID=call_pii_001

# From `.env.local.seeds` after `make seed`
TENANT_LENDING_ID=00000000-0000-0000-0000-000000000000

# The phone number of the seeded SFDC Contact used by the inbound story.
SEEDED_PHONE=+14155551234
SEEDED_CONTACT_NAME=Jane Doe
